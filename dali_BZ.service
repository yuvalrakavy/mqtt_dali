
# Remeber to do:
# Copy this file to /etc/systemd/system/dali.service
#
#  systemctl enable systemd-networkd.service systemd-networkd-wait-online.service
#
# In /etc/systemd/network directory add a file named local.network with:
#
# [Match]
# Name=eth0 | wlan0 
#
# [Network]
# DHCP=v4
#

[Unit]
Description=DALI controller
After=systemd-networkd-wait-online.service
Wants=systemd-networkd-wait-online.service

[Service]
# Log to a file (--log: logs/dali.<date>.log) and to the log server: logging.toml, next to the
# binary, adds GELF and OpenTelemetry. (Not LOG_DESTINATION: beside --log it is ignored, and on
# its own it replaces logging.toml's destinations, the log server with them.)
ExecStart=/home/yuval/mqtt_dali --log control-bz
WorkingDirectory=/home/yuval
StandardError=file:/home/yuval/logs/dali.err.log
Restart=always
User=root

[Install]
WantedBy=multi-user.target
