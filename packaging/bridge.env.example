# systemd EnvironmentFile syntax; this is configuration, not a shell script.
MQTT_DALI_INSTANCE=Controller
MQTT_DALI_BROKER=127.0.0.1:1883
MQTT_DALI_ROOT=DALI
MQTT_DALI_UART=/dev/serial0
MQTT_DALI_REPEAT_TERMINALS=unverified
# To use the standalone TCP HAT emulator instead of UART:
# MQTT_DALI_HAT_TCP=127.0.0.1:5580
# Web is optional. Set all three values to enable it; there is no default password.
# MQTT_DALI_WEB_BIND=127.0.0.1:8080
# MQTT_DALI_WEB_ORIGIN=http://127.0.0.1:8080
# MQTT_DALI_WEB_PASSWORD="choose a private password"
RUST_LOG=info,rumqttc=warn
